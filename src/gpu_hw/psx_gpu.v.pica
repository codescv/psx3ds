; psx_gpu.v.pica — PlayStation 1 batched hardware vertex shader for DMP PICA200
; NOTE: .fvec and .constf MUST appear BEFORE .proc main (Picasso requirement).

.fvec proj[4]
.fvec uv_scale
.fvec uv_bias
.constf consts(0.0, 1.0, 0.00390625, 0.0039215686)

.in v_pos v0
.in v_uv  v1
.in v_col v2

.out o_pos position
.out o_uv  texcoord0
.out o_col color

.proc main
    mov r0.xy, v_pos.xy
    mov r0.zw, consts.xy
    dp4 o_pos.x, proj[0], r0
    dp4 o_pos.y, proj[1], r0
    dp4 o_pos.z, proj[2], r0
    dp4 o_pos.w, proj[3], r0
    mul r1, uv_scale, v_uv
    add o_uv, uv_bias, r1
    mul o_col, consts.wwww, v_col
    end
.end
