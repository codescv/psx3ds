; psx_gpu.v.pica — PlayStation 1 2D/VRAM-space vertex shader for PICA200
.fvec proj[4]
.constf consts(0.0, 1.0, 0.00390625, 0.003921569)   ; 0, 1, 1/256, 1/255
.in v_pos v0
.in v_uv  v1
.in v_col v2
.in v_aux v3
.out o_pos position
.out o_uv  texcoord0
.out o_col color
.proc main
    mov r0.xy, v_pos.xy
    mov r0.zw, consts.xy
    dp4 o_pos.x, proj[0], r0
    dp4 o_pos.y, proj[1], r0
    dp4 o_pos.z, proj[2], r0
    dp4 o_pos.w, proj[3], r0
    mul o_uv, consts.zzzz, v_uv
    mul o_col, consts.wwww, v_col
    end
.end
